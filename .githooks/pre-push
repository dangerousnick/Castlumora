#!/usr/bin/env bash
set -Eeuo pipefail
cd "$(git rev-parse --show-toplevel)"
head=$(git rev-parse HEAD)
base=""
updates=0
while read -r local_ref local_oid remote_ref remote_oid; do
    updates=$((updates + 1))
    base=$remote_oid
    if [[ "$local_oid" != "$head" ]]; then
        echo "BLOCKED: pre-push validation covers checked-out HEAD only ($local_ref). Check out the commit being published." >&2
        exit 1
    fi
done
if [[ "$updates" != 1 ]]; then base=""; fi
exec ./scripts/validate-before-push.sh --base "$base"
